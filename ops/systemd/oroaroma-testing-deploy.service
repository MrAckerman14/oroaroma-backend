[Unit]
Description=Deploy CI-approved Oro Aroma testing commits
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/oroaroma-testing-deploy
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
