DATABASE_URL="postgresql://postgres:postgres@localhost:7567/zoko_hola_v2?schema=public"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET="change-me-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_DAYS=30
CORS_ORIGINS="http://localhost:9000,http://localhost:9100,http://localhost:5173,https://zoko-hola.onrender.com"
BCRYPT_ROUNDS=12
DEFAULT_SELLER_NAME="admin"
CASH_CLOSURE_MAX_SALES=500
BUSINESS_DAY_START_HOUR=7
DEFAULT_PAGE_SIZE=100
STORAGE_DRIVER=local
UPLOAD_ROOT=uploads
UPLOAD_PUBLIC_BASE_PATH=/uploads
UPLOAD_MAX_IMAGE_SIZE_MB=5
UPLOAD_ALLOWED_IMAGE_MIME_TYPES="image/jpeg:.jpg,image/png:.png,image/webp:.webp,image/avif:.avif"
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
CURRENCY_CODE="DOP"
CURRENCY_COUNTRY="DO"
CURRENCY_SYMBOL="RD$"
CURRENCY_GROUP_SEPARATOR=","
CURRENCY_DECIMAL_SEPARATOR="."
CURRENCY_MINOR_UNIT_DIGITS=2
CURRENCY_TRIM_ZERO_MINOR_UNITS=true
CURRENCY_SYMBOL_SPACING=false
