generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PermissionScope {
  GLOBAL
  STORE
  OWN
  ASSIGNED
}

enum SaleStatus {
  DELIVERY_PENDING
  FINALIZED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  MIXED
}

enum CashClosureStatus {
  PENDING
  VERIFIED
  VOIDED
}

enum ExpenseType {
  EXPENSE
  INCOME
}

model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                  User[]
  roles                  Role[]
  roleAssignments        UserRoleAssignment[]
  refreshSessions        RefreshSession[]
  stores                 Store[]
  sales                  Sale[]
  saleDetails            SaleDetail[]
  cashClosures           CashClosure[]
  cashClosureDetails     CashClosureDetail[]
  inventoryReports       InventoryReport[]
  inventoryReportDetails InventoryReportDetail[]
  auditLogs              AuditLog[]
  moduleSettings         TenantModuleSetting[]
  expenseCategories      ExpenseCategory[]
  expenseControls        ExpenseControl[]
  expenseReports         ExpenseReport[]
  expenseReportDetails   ExpenseReportDetail[]

  @@index([status])
}

model User {
  id               String     @id @default(uuid())
  tenantId         String     @default("default")
  name             String
  email            String     @unique
  passwordHash     String
  profileImagePath String?
  phone            String?
  status           UserStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleAssignments  UserRoleAssignment[]
  refreshSessions  RefreshSession[]
  employeeSales    Sale[]               @relation("EmployeeSales")
  messengerSales   Sale[]               @relation("MessengerSales")
  sellerSales      Sale[]               @relation("SellerSales")
  cashClosures     CashClosure[]        @relation("CashClosureCreator")
  inventoryReports InventoryReport[]    @relation("InventoryReportCreator")
  auditLogs        AuditLog[]
  platformRoles    PlatformRoleAssignment[]
  expenseControls  ExpenseControl[] @relation("ExpenseControlCreator")
  expenseReports   ExpenseReport[]  @relation("ExpenseReportCreator")

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @default("default")
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([tenantId])
  @@unique([tenantId, key])
}

model Permission {
  id          String          @id @default(uuid())
  key         String          @unique
  resource    String
  action      String
  scope       PermissionScope
  description String?
  createdAt   DateTime        @default(now())

  roles RolePermission[]

  @@unique([resource, action, scope])
  @@index([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id         String          @id @default(uuid())
  tenantId   String          @default("default")
  userId     String
  roleId     String
  scope      PermissionScope @default(GLOBAL)
  storeId    String?
  expiresAt  DateTime?
  assignedAt DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  store  Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@index([scope, storeId])
}

model RefreshSession {
  id        String    @id @default(uuid())
  tenantId  String    @default("default")
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

model Store {
  id            String    @id @default(uuid())
  tenantId      String    @default("default")
  name          String
  description   String?
  purchasePrice Decimal   @db.Decimal(12, 2)
  salePrice     Decimal   @db.Decimal(12, 2)
  stock         Int
  imagePath     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleAssignments  UserRoleAssignment[]
  saleDetails      SaleDetail[]
  inventoryDetails InventoryReportDetail[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([deletedAt])
  @@index([name])
}

model Sale {
  id             String        @id @default(uuid())
  tenantId       String        @default("default")
  employeeId     String
  messengerId    String?
  sellerId       String?
  amount         Decimal       @db.Decimal(12, 2)
  amountCash     Decimal       @default(0) @db.Decimal(12, 2)
  amountTransfer Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  deliveryPay    Decimal       @default(0) @db.Decimal(12, 2)
  perfumeCount   Int
  phone          String?
  description    String?
  locationUrl    String?
  status         SaleStatus    @default(DELIVERY_PENDING)
  finalizedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee       User                @relation("EmployeeSales", fields: [employeeId], references: [id])
  messenger      User?               @relation("MessengerSales", fields: [messengerId], references: [id])
  seller         User?               @relation("SellerSales", fields: [sellerId], references: [id])
  details        SaleDetail[]
  closureDetails CashClosureDetail[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([employeeId])
  @@index([messengerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model SaleDetail {
  id                String   @id @default(uuid())
  tenantId          String   @default("default")
  saleId            String
  storeId           String
  quantity          Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  purchaseUnitPrice Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([saleId])
  @@index([storeId])
}

model CashClosure {
  id                  String            @id @default(uuid())
  tenantId            String            @default("default")
  name                String
  note                String?
  createdById         String
  fromDate            DateTime
  toDate              DateTime
  totalCash           Decimal           @db.Decimal(12, 2)
  totalTransfer       Decimal           @db.Decimal(12, 2)
  totalSale           Decimal           @db.Decimal(12, 2)
  totalMessengerCost  Decimal           @db.Decimal(12, 2)
  netTotal            Decimal           @db.Decimal(12, 2)
  totalPerfumes       Int
  pendingMoney        Decimal           @default(0) @db.Decimal(12, 2)
  pendingCash         Decimal           @default(0) @db.Decimal(12, 2)
  pendingMessengerPay Decimal           @default(0) @db.Decimal(12, 2)
  internalSale        Decimal           @default(0) @db.Decimal(12, 2)
  generalSale         Decimal           @default(0) @db.Decimal(12, 2)
  status              CashClosureStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator User                @relation("CashClosureCreator", fields: [createdById], references: [id])
  details CashClosureDetail[]

  @@index([tenantId])
  @@index([tenantId, fromDate, toDate])
  @@index([createdById])
  @@index([fromDate, toDate])
  @@index([status])
}

model CashClosureDetail {
  id        String @id @default(uuid())
  tenantId  String @default("default")
  closureId String
  saleId    String

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  closure CashClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)
  sale    Sale        @relation(fields: [saleId], references: [id])

  @@unique([closureId, saleId])
  @@index([tenantId])
  @@index([saleId])
}

model InventoryReport {
  id                  String    @id @default(uuid())
  tenantId            String    @default("default")
  name                String
  note                String?
  fromDate            DateTime
  toDate              DateTime
  createdById         String
  totalProducts       Int
  totalInventoryValue Decimal   @db.Decimal(14, 2)
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator User                    @relation("InventoryReportCreator", fields: [createdById], references: [id])
  details InventoryReportDetail[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([createdById])
  @@index([createdAt])
}

model InventoryReportDetail {
  id                 String  @id @default(uuid())
  tenantId           String  @default("default")
  inventoryReportId  String
  productId          String
  productName        String
  productDescription String?
  purchasePrice      Decimal @db.Decimal(12, 2)
  stock              Int
  inventoryValue     Decimal @db.Decimal(14, 2)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report  InventoryReport @relation(fields: [inventoryReportId], references: [id], onDelete: Cascade)
  product Store           @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([inventoryReportId])
  @@index([productId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @default("default")
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model PlatformPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles PlatformRolePermission[]

  @@unique([resource, action])
}

model PlatformRole {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PlatformRolePermission[]
  assignments PlatformRoleAssignment[]
}

model PlatformRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PlatformRoleAssignment {
  id        String    @id @default(uuid())
  userId    String
  roleId    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

model ModuleCatalog {
  key            String   @id
  name           String
  description    String?
  defaultEnabled Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantSettings TenantModuleSetting[]
}

model TenantModuleSetting {
  tenantId String
  moduleKey String
  enabled  Boolean @default(true)
  config   Json?
  updatedAt DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module ModuleCatalog @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@id([tenantId, moduleKey])
  @@index([tenantId, enabled])
}

model ExpenseCategory {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  normalizedName String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  movements ExpenseControl[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId, deletedAt])
}

model ExpenseControl {
  id          String      @id @default(uuid())
  tenantId    String
  amount      Decimal     @db.Decimal(14, 2)
  type        ExpenseType
  categoryId  String
  date        DateTime
  description String?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator  User            @relation("ExpenseControlCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, date])
  @@index([tenantId, type, date])
  @@index([categoryId])
  @@index([createdById])
  @@index([deletedAt])
}

model ExpenseReport {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  note         String?
  fromDate     DateTime
  toDate       DateTime
  totalIncome  Decimal  @db.Decimal(14, 2)
  totalExpense Decimal  @db.Decimal(14, 2)
  balance      Decimal  @db.Decimal(14, 2)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator User                  @relation("ExpenseReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  details ExpenseReportDetail[]

  @@index([tenantId, createdAt])
  @@index([createdById])
  @@index([deletedAt])
}

model ExpenseReportDetail {
  id              String  @id @default(uuid())
  tenantId        String
  expenseReportId String
  categoryName    String
  income          Decimal @db.Decimal(14, 2)
  expense         Decimal @db.Decimal(14, 2)
  balance         Decimal @db.Decimal(14, 2)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report ExpenseReport @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expenseReportId])
}
