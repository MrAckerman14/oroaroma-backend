{
  "name": "oroaroma-api-v2",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm install --include=dev && prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/main.js",
    "start:server": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "cross-env RUN_DB_TESTS=true vitest run src/infrastructure/database/tenantIsolation.integration.test.ts src/infrastructure/database/tenantProvisioning.integration.test.ts src/infrastructure/database/expenseControl.integration.test.ts src/infrastructure/database/branchInventory.integration.test.ts src/infrastructure/database/warehouseInventory.integration.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Oro Aroma API v2 built from scratch with Fastify, Prisma, TypeScript, DDD, Clean Architecture and granular RBAC.",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@prisma/client": "^6.12.0",
    "@types/node": "^25.9.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.12.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrAckerman14/oroaroma-backend.git"
  },
  "bugs": {
    "url": "https://github.com/MrAckerman14/oroaroma-backend/issues"
  },
  "homepage": "https://github.com/MrAckerman14/oroaroma-backend#readme"
}
